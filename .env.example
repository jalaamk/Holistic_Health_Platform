# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin (Server-side)
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@your_project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# OpenAI Configuration
OPENAI_API_KEY=sk-...

# Application Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Security
SESSION_SECRET=your_session_secret_at_least_32_chars_long

# Feature Flags (optional)
NEXT_PUBLIC_ENABLE_AI_FEATURES=true
NEXT_PUBLIC_ENABLE_PROFESSIONAL_SUITE=false

# Integration Providers

# Fitbit Integration
FITBIT_CLIENT_ID=your_fitbit_client_id
FITBIT_CLIENT_SECRET=your_fitbit_client_secret
FITBIT_WEBHOOK_SECRET=your_fitbit_webhook_secret

# Google Fit Integration
GOOGLE_FIT_CLIENT_ID=your_google_fit_client_id
GOOGLE_FIT_CLIENT_SECRET=your_google_fit_client_secret
GOOGLE_FIT_WEBHOOK_SECRET=your_google_fit_webhook_secret

# Apple Health Integration
APPLE_HEALTH_CONTAINER_ID=iCloud.com.wellnessos.health
APPLE_HEALTH_KEY_ID=your_apple_health_key_id
APPLE_HEALTH_TEAM_ID=your_apple_health_team_id
APPLE_HEALTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Garmin Integration
GARMIN_CONSUMER_KEY=your_garmin_consumer_key
GARMIN_CONSUMER_SECRET=your_garmin_consumer_secret

# Whoop Integration
WHOOP_CLIENT_ID=your_whoop_client_id
WHOOP_CLIENT_SECRET=your_whoop_client_secret

# Oura Ring Integration
OURA_CLIENT_ID=your_oura_client_id
OURA_CLIENT_SECRET=your_oura_client_secret

# Epic FHIR Integration
EPIC_FHIR_CLIENT_ID=your_epic_fhir_client_id
EPIC_FHIR_REDIRECT_URI=https://your-app.com/api/integrations/oauth/callback

# Cerner FHIR Integration
CERNER_FHIR_CLIENT_ID=your_cerner_fhir_client_id
CERNER_FHIR_REDIRECT_URI=https://your-app.com/api/integrations/oauth/callback
CERNER_FHIR_VERSION=R4

# Google Calendar Integration
GOOGLE_CALENDAR_CLIENT_ID=your_google_calendar_client_id
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_calendar_client_secret

# Outlook Calendar Integration
OUTLOOK_CALENDAR_CLIENT_ID=your_outlook_calendar_client_id
OUTLOOK_CALENDAR_CLIENT_SECRET=your_outlook_calendar_client_secret
OUTLOOK_CALENDAR_TENANT_ID=your_outlook_calendar_tenant_id
